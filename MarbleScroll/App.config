            <setting name="SmoothScrolling" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="LockEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Reverse" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SnapToAxis" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Momentum" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Paused" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ScrollSpeed" serializeAs="String">
